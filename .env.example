# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# USDA NASS QuickStats — state yields and prices for /report
# Free key: https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# OpenET — measured crop water use (evapotranspiration)
# Free key: https://account.etdata.org
OPENET_API_KEY=

# NASA Earthdata login — only needed for AppEEARS (SMAP / NDVI), not used yet
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
